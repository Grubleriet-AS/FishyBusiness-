# Det Store Blå on the Hetzner server (tools/server/setup.sh puts the domain in for @DOMAIN@). Caddy fetches and renews the HTTPS
# certificate itself. The map packs and the data files (the models, 29.10.2026) have their hash in the name, so they are cached for a
# year; the page, the service worker and the manifests are always checked; the admin page is never cached or indexed.
# What the production and the test edition share (L1a, 10.11.2026): the pages without .html, the compressed data files, the headers
# and the cache rules.
# Caddy's own counts of requests by status (steg 138, 17.11.2026): on its admin port on 127.0.0.1:2019 only, with no addresses and no
# paths; the watch (tools/server/vakt/vakt.sh) keeps the total once an hour for tools/server/status.sh
# (the global option since 18.11.2026: Caddy warned that «metrics» inside «servers» goes away in its next major version)
{
	metrics
}
(dsb) {
	# /personvern and /vilkar (the links on Google's sign-in screen) are personvern.html and vilkar.html
	try_files {path} {path}.html
	# the data files have their compressed copies beside them (build.mjs, 04.11.2026): X.bin.br or X.bin.gz for X.bin, as the
	# browser takes it; encode above leaves an octet-stream as it is
	file_server {
		precompressed br gzip
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# nothing here is shown inside another site's frame (L1e, 11.11.2026, funn 7): the game's own policy for scripts and hosts is
		# a <meta> in the page (build.mjs CSP_OF), and frame-ancestors cannot be set there. The browser holds the page to both.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
	}
	@packs path_regexp packs ^/(map/.+\.wasm|data/.+\.bin)$
	header @packs Cache-Control "public, max-age=31536000, immutable"
	@fresh path / /index.html /sw.js /manifest.webmanifest /map/manifest.json /data/manifest.json /version.json /nodbrems.json
	header @fresh Cache-Control "no-cache"
	@admin path /admin /admin/*
	# the admin page is never shown inside another site's frame (Ø6 funn 15, 05.11.2026; its CSP for the scripts is in the page, build.mjs)
	header @admin {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}
}
@DOMAIN@ {
	root * /srv/detstorebla/current
	# the real-time relay (tools/server/rt/server.mjs, docs/planer/sanntid-posisjoner.md S2, 05.11.2026): the WebSocket at /rt goes to the
	# Node service on this machine (dsb-rt, setup.sh), which listens only on 127.0.0.1; nothing else goes there, and it is not compressed
	@rt path /rt
	reverse_proxy @rt 127.0.0.1:8787
	@notrt not path /rt
	encode @notrt zstd gzip
	import dsb
}
www.@DOMAIN@ {
	redir https://@DOMAIN@{uri} permanent
}
# The test edition (L1a, 10.11.2026, docs/planer/lansering-plan.md): the working branch built with KYST_CHANNEL=test, uploaded to
# /srv/detstorebla/test by deploy.yml. Its own origin, so its own saves and service worker; never indexed. The real-time relay is the
# production's and is not reached from here (the test edition's boats go by the 15 s reports).
# The build that is about to go to the players, tried first (live-drift fase 4, 18.11.2026): .github/workflows/autofix.yml uploads main +
# an automatic fix, built exactly as for the production, to /srv/detstorebla/auto and opens it at https://test.@DOMAIN@/auto/ before
# «Slipp» moves main. The root is the site's folder, so /auto/x is auto/x (nothing else of the folder is reached: only /auto/* comes here).
# The game's paths are relative (the service worker is registered as sw.js), so it runs under /auto/ with its own worker scope; the
# check opens it with #nocloud, so it talks to no database. Never indexed.
test.@DOMAIN@/auto/* {
	root * /srv/detstorebla
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	import dsb
}
test.@DOMAIN@ {
	root * /srv/detstorebla/test
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	import dsb
}
